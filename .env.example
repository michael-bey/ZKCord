# From the Discord developer portal (see the Self-hosting page in the wiki)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_PUBLIC_KEY=
# Same value as DISCORD_CLIENT_ID; used for the "Add to Discord" link
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# Upstash Redis from the Vercel Marketplace. `vercel env pull` fills these in.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Public HTTPS URL of the site. Passport proofs are bound to this domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
